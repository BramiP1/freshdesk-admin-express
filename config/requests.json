{
  "vercelLookup": {
    "schema": {
      "method": "GET",
      "host": "freshdesk-admin-express.vercel.app",
      "path": "/api/lookup?email={{context.email}}",
      "headers": {
        "Content-Type": "application/json"
      }
    }
  },
  "freshdeskOpenTickets": {
    "schema": {
      "method": "GET",
      "host": "<%= iparam.freshdesk_domain %>",
      "path": "/api/v2/tickets?requester_id={{context.contactId}}&status=2&per_page=100",
      "headers": {
        "Authorization": "Basic <%= encode(iparam.freshdesk_api_key + ':X') %>",
        "Content-Type": "application/json"
      }
    }
  },
  "freshdeskContact": {
    "schema": {
      "method": "GET",
      "host": "<%= iparam.freshdesk_domain %>",
      "path": "/api/v2/contacts/{{context.contactId}}",
      "headers": {
        "Authorization": "Basic <%= encode(iparam.freshdesk_api_key + ':X') %>",
        "Content-Type": "application/json"
      }
    }
  }
}
